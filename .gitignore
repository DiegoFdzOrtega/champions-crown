# Archivos que Windows / macOS crean solos y no aportan nada al proyecto
Thumbs.db
desktop.ini
.DS_Store

# Configuración personal del editor (VS Code)
.vscode/

# Archivos temporales o copias de seguridad
*.tmp
*.bak
*~

# Vídeos y material de promoción (no forman parte del juego)
material/trailer/

# Música original sin comprimir (pesa mucho): solo se sube la de assets/musica/<Región>/ ya optimizada
assets/musica/Musica2/

# Ilustraciones originales de Pokémon Masters (pesan mucho): solo se sube lo ya optimizado en assets/fondos/tarjeta/ y assets/avatares/
material/pokemon_masters/

# Copias de seguridad hechas a mano (el historial ya lo guarda Git)
_backups/
